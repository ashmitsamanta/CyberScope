# CYBERSCOPE Environment Configuration
# Copy this file to .env and configure secret parameters

# Application
APP_NAME=CYBERSCOPE
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration
# Local SQLite default (zero-friction execution):
DATABASE_URL=sqlite:///./cyberscope.db

# PostgreSQL (used by Docker Compose - database ports remain internal):
POSTGRES_USER=cyberscope_app
POSTGRES_PASSWORD=generate_or_set_secure_password_here
POSTGRES_DB=cyberscope_prod

# Graph Service
# GRAPH_BACKEND: "networkx" (active in-memory synchronized engine)
GRAPH_BACKEND=networkx

# AI Provider / CYBER-ASSIST
# AI_PROVIDER: "fallback" (deterministic explainable expert engine) or "openai"
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Security & Limits
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=120

# Supabase Authentication & Database Configuration
# Obtain credentials from your Supabase project: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT Secret (found in Project Settings -> API -> JWT Settings):
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Enforce authentication on API endpoints (True/False - defaults to False for demo evaluation):
REQUIRE_AUTH=False

# Optional: To connect backend directly to Supabase PostgreSQL database:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
