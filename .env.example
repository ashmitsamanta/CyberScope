# CYBERSCOPE Environment Configuration

# Application
APP_NAME=CYBERSCOPE
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database
# Local SQLite default (zero friction):
DATABASE_URL=sqlite:///./cyberscope.db
# PostgreSQL option (e.g. for Docker or production):
# DATABASE_URL=postgresql://cyberscope:cyberscope_secret@postgres:5432/cyberscope_db

# Graph Service
# GRAPH_BACKEND options: "networkx" (in-memory + relational sync, zero-friction) or "neo4j"
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cyberscope_neo4j

# AI Provider / CYBER-ASSIST
# AI_PROVIDER options: "fallback" (deterministic explainable expert engine) or "openai"
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Security & Limits
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=120
